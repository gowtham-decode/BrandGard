# BrandGuard Backend Environment Configuration
PROJECT_NAME="BrandGuard AI Digital Risk Protection"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database: SQLite for zero-friction local development, PostgreSQL in production
DATABASE_URL="sqlite:///./brandguard.db"
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/brandguard

# Security & Authentication
SECRET_KEY="brandguard-dev-super-secret-key-change-in-production-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional: set a private password to seed the demo analyst account.
DEMO_ADMIN_PASSWORD=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Model Paths
MODEL_PATH="ml/models/baseline_rf_v1.json"
